<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, all network traffic must use HTTPS/TLS (cleartext traffic disabled) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Narrow exceptions for local P2P hotspot transfer addresses only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.49.1</domain>
        <domain includeSubdomains="true">192.168.43.1</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
